# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=123456:replace-me
# Optional: a local Bot API server (raises the upload limit from 50 MB to 2000 MB).
#TELEGRAM_API_URL=http://telegram-bot-api:8081
# Chat the bot posts files to before attaching them to inline messages:
# a private channel with the bot as admin (ID like -1001234567890). Empty disables inline downloads.
STORAGE_CHAT_ID=

# ytdl-service: base URL and an API key issued by its admin.
YTDL_BASE_URL=http://ytdl-service-app-1:8080
YTDL_API_KEY=ytdl_replace-me

# PostgreSQL: the "tgbot" database in the existing ytdl-service PostgreSQL container.
DATABASE_URL=postgres://USER:PASSWORD@ytdl-service-postgres-1:5432/tgbot?sslmode=disable

# Comma-separated Telegram user IDs that are always admins.
ADMIN_IDS=
# Requests per user per day (UTC) unless set per user with /limit.
DEFAULT_DAILY_LIMIT=20

# Task polling.
POLL_INTERVAL=3s
TASK_TIMEOUT=20m
# Simultaneous uploads to Telegram (each is buffered in memory).
MAX_CONCURRENT_UPLOADS=4
# Default: 50 (2000 with TELEGRAM_API_URL).
#MAX_UPLOAD_MB=50

# debug, info, warn, error
LOG_LEVEL=info
